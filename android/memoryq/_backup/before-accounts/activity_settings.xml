<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="Settings"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/settingsHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Server address"
            android:inputType="textNoSuggestions"
            android:singleLine="true" />

        <Button
            android:id="@+id/settingsFind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find server" />

        <TextView
            android:id="@+id/settingsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/settingsKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Stream key"
            android:inputType="textPassword"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/showKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show key" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:text="The key stays on this phone and is not included in backups."
            android:textSize="12sp" />

        <Button
            android:id="@+id/settingsSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save" />

        <Button
            android:id="@+id/settingsHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Home" />
    </LinearLayout>
</ScrollView>