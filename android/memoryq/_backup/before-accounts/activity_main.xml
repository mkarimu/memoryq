<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="158dp"
            android:visibility="gone" />

        <SurfaceView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/viewerNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginEnd="158dp"
            android:background="#99000000"
            android:padding="6dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/tileScroll"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginTop="92dp"
            android:background="#CC000000"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/tileRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>

    <ScrollView
        android:id="@+id/panel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="Starting..."
                android:textSize="16sp" />

            <EditText
                android:id="@+id/host"
            android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Server address"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />

            <Button
                android:id="@+id/findBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Find server" />

            <EditText
                android:id="@+id/key"
            android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Stream key"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />

            <EditText
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Title (optional)"
                android:inputType="textCapSentences"
                android:maxLength="40"
                android:singleLine="true" />

            <LinearLayout
                android:id="@+id/liveControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/startBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Start" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/pauseBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pause" />

                    <Button
                        android:id="@+id/stopBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Stop" />
                </LinearLayout>

                <Button
                    android:id="@+id/switchBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Switch camera" />

                <Button
                    android:id="@+id/watchBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Watch channels" />
            </LinearLayout>

            <TextView
                android:id="@+id/orientationHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="Portrait mode is for typing. Turn the phone sideways to see the camera and go live."
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/settingsBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings" />

            <Button
                android:id="@+id/homeBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Home" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>